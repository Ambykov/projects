# STT Gateway Configuration
# Copy this file to .env and update values for your environment

# GigaSTT upstream URLs (use service names in Docker Compose)
GIGASTT_WS_URL=ws://gigastt:9876/v1/ws
GIGASTT_REST_URL=http://gigastt:9876/v1/transcribe
GIGASTT_HEALTH_URL=http://gigastt:9876/health

# Gateway binding
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# Authentication mode: api_key | jwt | none
AUTH_MODE=api_key

# API key authentication (required when AUTH_MODE=api_key)
API_KEY=change-me-in-production

# JWT authentication (required when AUTH_MODE=jwt)
# JWT_SECRET=change-me
# JWT_ALGORITHM=HS256
# JWT_AUDIENCE=stt-gateway

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Limits
MAX_CONCURRENT_SESSIONS=20
MAX_UPLOAD_MB=10
SESSION_IDLE_TIMEOUT_SEC=30

# CORS origins (comma-separated)
CORS_ORIGINS=https://stt.company.local,http://localhost:3000

# Public hostname for docs and version endpoint
PUBLIC_HOSTNAME=stt.company.local
